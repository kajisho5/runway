# secrets.env にコピーして値を入れる（secrets.env は .gitignore 済み。絶対にコミットしない）

# App Store Connect API キー（ユーザとアクセス → 統合 → App Store Connect API）
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# .p8 はパスを書けばスクリプトが base64 化する。直接書くなら ASC_KEY_P8_BASE64 を使う
ASC_KEY_P8_PATH=./AuthKey_XXXXXXXXXX.p8
# ASC_KEY_P8_BASE64=

# developer.apple.com → Membership details の Team ID
APPLE_TEAM_ID=XXXXXXXXXX


# hanger を読み書きできる GitHub の Fine-grained PAT（Contents: Read and write）
MATCH_GIT_TOKEN=github_pat_xxxxxxxxxxxxxxxx

# 任意：TestFlight 外部テスト（Beta App Review）の連絡先。入れると各アプリにも配る
# BETA_CONTACT_EMAIL=
# BETA_CONTACT_FIRST=
# BETA_CONTACT_LAST=
# BETA_CONTACT_PHONE=+81...
